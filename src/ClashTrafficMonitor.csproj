<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>ClashTrafficMonitor</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>../assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Content Include="../assets/app.ico" Link="app.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
</Project>
